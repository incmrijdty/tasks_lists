<html>
  <head>
    <meta charset="UTF-8" />
    <title><%= headTitle %></title>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/main.css" />
  </head>
  <body>
    <%- include('partials/navigation', { menuLinks, activeLinkPath }); %>
    <main class="layout">

      <aside class="sidebar">
        <h2>Your Tasks</h2>
        <ul class="task_menu">
          <% savedTasks.forEach(task => { %>
          <li><a href="/<%= task.id %>"><%= task.id %></a></li>
          <% }); %>
        </ul>
        <div id="modalOverlay" class="modal-overlay hidden">
          <div class="modal-window">
            <h2>Create New Task</h2>
            <form action="/add" method="POST">
              <input type="text" id="id" placeholder="Task id" required />
              <input type="text" content="content" placeholder="Task content" required />
              
              <div style="margin-top: 1rem;">
                <button class ="button" type="submit" class="button">Create</button>
                <button type="button" class="button close-modal">Cancel</button> 
              </div>
            </form>
          </div>
        </div>
        <button class="create_task_btn" id="openModalBtn">+ Create New Task</button>
      </aside>

      <section class="content_area">
        <h1 class="heading">Your Tasks</h1>
      </section>
    </main>
    
    <script>
      const modal = document.getElementById('modalOverlay');
      const openBtn = document.getElementById('openModalBtn');
      const closeBtns = document.querySelectorAll('.close-modal');

      openBtn.addEventtaskener('click', () => {
        modal.classTask.remove('hidden');
      });

      closeBtns.forEach(btn => {
        btn.addEventtaskener('click', () => {
          modal.classTask.add('hidden');
        });
      });

      modal.addEventtaskener('click', (e) => {
        if (e.target === modal) {
          modal.classTask.add('hidden');
        }
      });
    </script>
  </body>
</html>
